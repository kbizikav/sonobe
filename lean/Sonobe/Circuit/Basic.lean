import Sonobe.Arith.R1CS

/-!
Constraint-level circuit modelling.

A gadget is a conjunction of field equations (`Rel`) over its inputs and the witnesses it allocates;
we prove `Rel ⇒ Spec` (soundness: nothing is under-constrained) and `Spec ⇒ ∃ witness, Rel`
(completeness). Each `Rel` mirrors the constraints generated by the corresponding
ark-r1cs-std / sonobe gadget (cited in the doc comments).

The single *trusted bridge* between the Lean constraint model and the R1CS matrices is
`Circuit.Compiles`: the arkworks synthesizer turns the allocated variables into exactly the
assignment `(x, w)` of the R1CS.
-/

namespace Sonobe
namespace Gadget

open R1CS
open scoped Classical

/-- A circuit with `l` public inputs, `nw` witness variables, and a structured view `Ω` of the
witness; `rel` is the conjunction of its gadget constraints. -/
structure Circuit (F : Type*) (l nw : ℕ) (Ω : Type*) where
  rel : (Fin l → F) → Ω → Prop
  decode : (Fin nw → F) → Ω
  decode_surj : Function.Surjective decode

variable {F : Type*} [Field F]

/-- Trusted: the R1CS produced by the synthesizer is the circuit's constraint system. -/
def Circuit.Compiles {m l nw : ℕ} {Ω : Type*} (c : Circuit F l nw Ω) (r : R1CS F m l nw) : Prop :=
  ∀ x w, r.Sat x w ↔ c.rel x (c.decode w)

/-- Soundness direction of `Compiles`, the one the proofs use. -/
theorem Circuit.rel_of_sat {m l nw : ℕ} {Ω : Type*} {c : Circuit F l nw Ω} {r : R1CS F m l nw}
    (h : c.Compiles r) {x w} (hs : r.Sat x w) : c.rel x (c.decode w) := (h x w).mp hs

/-- Completeness direction: any structured witness satisfying `rel` is realised as an assignment. -/
theorem Circuit.sat_of_rel {m l nw : ℕ} {Ω : Type*} {c : Circuit F l nw Ω} {r : R1CS F m l nw}
    (h : c.Compiles r) {x} {ω : Ω} (hr : c.rel x ω) : ∃ w, r.Sat x w := by
  obtain ⟨w, rfl⟩ := c.decode_surj ω
  exact ⟨w, (h x w).mpr hr⟩

/-! ### Elementary gadgets -/

/-- `Boolean::new_witness`: `b·(b-1) = 0`. -/
def IsBool (b : F) : Prop := b * (b - 1) = 0

theorem isBool_iff {b : F} : IsBool b ↔ b = 0 ∨ b = 1 := by
  unfold IsBool
  rw [mul_eq_zero, sub_eq_zero]

/-- `FpVar::is_zero`: witness `inv`, output `b`, constraints `x·inv = 1 - b` and `x·b = 0`. -/
def IsZeroRel (x b inv : F) : Prop := x * inv = 1 - b ∧ x * b = 0

theorem isZero_sound {x b inv : F} (h : IsZeroRel x b inv) : b = if x = 0 then 1 else 0 := by
  obtain ⟨h1, h2⟩ := h
  split_ifs with hx
  · subst hx
    have : 0 = 1 - b := by simpa using h1
    linear_combination this
  · have : b = 0 := (mul_eq_zero.mp h2).resolve_left hx
    exact this

theorem isZero_complete (x : F) : ∃ b inv, IsZeroRel x b inv ∧ b = if x = 0 then 1 else 0 := by
  by_cases hx : x = 0
  · exact ⟨1, 0, by simp [IsZeroRel, hx], by simp [hx]⟩
  · exact ⟨0, x⁻¹, by simp [IsZeroRel, hx], by simp [hx]⟩

/-- `Boolean::select`: `o = c·(t - f) + f`. -/
def SelectRel (c t f o : F) : Prop := o = c * (t - f) + f

theorem select_sound {c t f o : F} (hc : IsBool c) (h : SelectRel c t f o) :
    o = if c = 1 then t else f := by
  rcases isBool_iff.mp hc with rfl | rfl <;> simp_all [SelectRel]

/-- `conditional_enforce_equal`: `c·(a - b) = 0`. -/
def CondEqRel (c a b : F) : Prop := c * (a - b) = 0

theorem condEq_sound {c a b : F} (hc : c = 1) (h : CondEqRel c a b) : a = b := by
  subst hc; simpa [CondEqRel, sub_eq_zero] using h

end Gadget
end Sonobe
